# Application
QUERYGUARD_ENVIRONMENT=local
QUERYGUARD_LOG_LEVEL=INFO
QUERYGUARD_LOG_FORMAT=json
QUERYGUARD_API_HOST=0.0.0.0
QUERYGUARD_API_PORT=8000
QUERYGUARD_API_BASE_URL=http://localhost:8000

# Database schemas
QUERYGUARD_ERP_SCHEMA=erp
QUERYGUARD_AUDIT_SCHEMA=queryguard_audit
QUERYGUARD_APPROVED_SCHEMAS=["erp"]

# The owner URL is for migrations and deterministic seeding only.
# It must not be injected into the runtime API container.
QUERYGUARD_OWNER_DATABASE_URL=postgresql+psycopg://queryguard_owner:change-me-owner@localhost:5432/queryguard

# Generated ERP queries execute only through this read-only connection.
QUERYGUARD_QUERY_DATABASE_URL=postgresql+psycopg://queryguard_reader:change-me-reader@localhost:5432/queryguard

# Audit and feedback writes use a separate role with access only to the audit schema.
QUERYGUARD_AUDIT_DATABASE_URL=postgresql+psycopg://queryguard_audit_writer:change-me-audit@localhost:5432/queryguard

# Query safety limits; the plan-cost threshold will be calibrated in Phase 4.
QUERYGUARD_MAX_RESULT_ROWS=500
QUERYGUARD_STATEMENT_TIMEOUT_MS=5000
QUERYGUARD_MAX_ESTIMATED_PLAN_COST=100000
QUERYGUARD_CONFIRMATION_TTL_SECONDS=900

# Reproducible synthetic data and relative-date interpretation
QUERYGUARD_RANDOM_SEED=42
QUERYGUARD_DATA_AS_OF_DATE=2026-06-30

# OpenAI (not required until Phase 3)
OPENAI_API_KEY=
QUERYGUARD_OPENAI_MODEL=gpt-5.6-terra
QUERYGUARD_OPENAI_REASONING_EFFORT=medium
QUERYGUARD_OPENAI_TIMEOUT_SECONDS=30
QUERYGUARD_LIVE_LLM_TESTS=false

